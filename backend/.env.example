# === Fluxo Backend Environment ===
PORT=5000
NODE_ENV=production

# MongoDB (use Atlas URI for production)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/fluxo

# JWT
JWT_SECRET=<generate-64-char-random-string>
JWT_EXPIRES_IN=1d

# AI Services
GROQ_API_KEY=<your-groq-api-key>
ML_SERVICE_URL=https://<your-ml-service>.onrender.com
RAG_SERVICE_URL=https://<your-rag-service>.onrender.com

# CORS (comma-separated origins)
CORS_ORIGINS=https://fluxo.vercel.app,http://localhost:5173
